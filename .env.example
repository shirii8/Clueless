# --- Model provider (all LLM calls go through LiteLLM) -----------------------
# Tuned and tested default. Any LiteLLM-supported provider works without code
# changes, e.g. openai/<model>, azure/<deployment>, gemini/<model>.
LLM_MODEL=gemini/gemini-2.5-flash
LLM_API_KEY=
# Optional, e.g. for Azure or a self-hosted OpenAI-compatible endpoint.
LLM_API_BASE=
# Optional. Leave blank: the shipped solution does not use embeddings
# (retrieval is structured SQL over the knowledge base).
EMBEDDING_MODEL=
# Seconds before a model call is abandoned and the deterministic fallback is used.
LLM_TIMEOUT_S=25

# --- Local database (bundled Postgres service) -------------------------------
POSTGRES_DB=clueless
POSTGRES_USER=clueless
POSTGRES_PASSWORD=clueless-local-only
DATABASE_URL=postgresql+psycopg://clueless:clueless-local-only@db:5432/clueless

# --- Ports -------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3001
ADMINER_PORT=8080
